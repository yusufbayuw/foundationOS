{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "bezhansalleh/filament-shield": "^4.2",
        "coolsam/modules": "^5.1",
        "filament/filament": "^5.4",
        "jwadhams/json-logic-php": "^1.5",
        "laravel/framework": "^13.0",
        "laravel/pulse": "^1.7",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "midtrans/midtrans-php": "^2.6",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-activitylog": "^5.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\Campus\\": "Modules/Campus/app/",
            "Modules\\Core\\": "Modules/Core/app/",
            "Modules\\Employee\\": "Modules/Employee/app/",
            "Modules\\Enrollment\\": "Modules/Enrollment/app/",
            "Modules\\Finance\\": "Modules/Finance/app/",
            "Modules\\Global\\": "Modules/Global/app/",
            "Modules\\Inventory\\": "Modules/Inventory/app/",
            "Modules\\Library\\": "Modules/Library/app/",
            "Modules\\Monitoring\\": "Modules/Monitoring/app/",
            "Modules\\Procurement\\": "Modules/Procurement/app/",
            "Modules\\Sales\\": "Modules/Sales/app/",
            "Modules\\School\\": "Modules/School/app/",
            "Modules\\Workflow\\": "Modules/Workflow/app/",
            "Modules\\Alumni\\": "Modules/Alumni/app/",
            "Modules\\Member\\": "Modules/Member/app/",
            "Modules\\Asset\\": "Modules/Asset/app/",
            "Modules\\Boarding\\": "Modules/Boarding/app/",
            "Modules\\Cafeteria\\": "Modules/Cafeteria/app/",
            "Modules\\Capacity\\": "Modules/Capacity/app/",
            "Modules\\Ai\\": "Modules/Ai/app/",
            "Modules\\Clinic\\": "Modules/Clinic/app/",
            "Modules\\Cms\\": "Modules/Cms/app/",
            "Modules\\Counseling\\": "Modules/Counseling/app/",
            "Modules\\Dms\\": "Modules/Dms/app/",
            "Modules\\Donation\\": "Modules/Donation/app/",
            "Modules\\EducationQa\\": "Modules/EducationQa/app/",
            "Modules\\Exam\\": "Modules/Exam/app/",
            "Modules\\EOffice\\": "Modules/EOffice/app/",
            "Modules\\Event\\": "Modules/Event/app/",
            "Modules\\Facility\\": "Modules/Facility/app/",
            "Modules\\Helpdesk\\": "Modules/Helpdesk/app/",
            "Modules\\InternalAudit\\": "Modules/InternalAudit/app/",
            "Modules\\IsoCompliance\\": "Modules/IsoCompliance/app/",
            "Modules\\ItOps\\": "Modules/ItOps/app/",
            "Modules\\KpiEnterprise\\": "Modules/KpiEnterprise/app/",
            "Modules\\Legal\\": "Modules/Legal/app/",
            "Modules\\MerchOrder\\": "Modules/MerchOrder/app/",
            "Modules\\Messaging\\": "Modules/Messaging/app/",
            "Modules\\PhysicalSecurity\\": "Modules/PhysicalSecurity/app/",
            "Modules\\Risk\\": "Modules/Risk/app/",
            "Modules\\Training\\": "Modules/Training/app/",
            "Modules\\Printing\\": "Modules/Printing/app/",
            "Modules\\Consulting\\": "Modules/Consulting/app/",
            "Modules\\Property\\": "Modules/Property/app/",
            "Modules\\Marketplace\\": "Modules/Marketplace/app/",
            "Modules\\Voucher\\": "Modules/Voucher/app/",
            "Modules\\Transport\\": "Modules/Transport/app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi",
            "php -d pcov.directory=/workspace vendor/bin/phpunit -c phpunit.coverage.xml --coverage-clover=coverage/clover.xml"
        ],
        "test:coverage-check": [
            "@test:coverage",
            "@php scripts/check-coverage-threshold.php coverage/clover.xml 80"
        ],
        "lint:translations": [
            "@php scripts/lint-translations.php"
        ],
        "lint": [
            "vendor/bin/pint --test"
        ],
        "lint:tenant-fields": [
            "@php scripts/lint-tenant-fields.php"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "analyse:app": [
            "vendor/bin/phpstan analyse --configuration=phpstan-app.neon --memory-limit=512M"
        ],
        "analyse:baseline": [
            "vendor/bin/phpstan analyse --memory-limit=1G --generate-baseline"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
