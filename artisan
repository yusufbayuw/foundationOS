#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

$minimumCliMemory = '256M';
$currentMemory = ini_get('memory_limit');

if ($currentMemory !== false && $currentMemory !== '-1' && ini_parse_quantity($currentMemory) < ini_parse_quantity($minimumCliMemory)) {
    ini_set('memory_limit', $minimumCliMemory);
    $currentMemory = ini_get('memory_limit');
}

if ($currentMemory !== false && $currentMemory !== '-1' && ini_parse_quantity($currentMemory) < ini_parse_quantity($minimumCliMemory)) {
    fwrite(STDERR, "foundationOS requires at least {$minimumCliMemory} of memory for Artisan commands.\n");

    exit(1);
}

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$status = $app->handleCommand(new ArgvInput);

exit($status);
